# Copie para .env e ajuste.  NUNCA versionar o .env (contém segredos).
#   cp .env.example .env

# --- App ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# --- MongoDB ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=tcc_ocr_llm
MONGO_COLLECTION=documents

# --- Armazenamento dos arquivos originais (volume) ---
UPLOAD_DIR=/data/uploads

# --- OCR ---
OCR_LANG=por
OCR_PREPROCESS=true        # cinza + upscale + autocontraste + remoção de ruído (baixo risco)
OCR_BINARIZE=false         # binarização por limiar — opt-in (pode piorar imagens boas)
OCR_MIN_CHARS=20
OCR_TIMEOUT_SECONDS=60
PDF_DPI=300
# POPPLER_PATH=            # opcional, apenas para rodar fora do container (Windows)

# --- LLM (camada isolada) ---
# Primeira execução: deixe em "fake" (não precisa de chave, gera dados de exemplo).
# Troque para "openai" quando tiver uma LLM_API_KEY válida.
LLM_PROVIDER=fake          # fake | openai
LLM_API_KEY=changeme       # NUNCA commitar valor real — mantenha só no .env
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini      # use um modelo OpenAI REAL (gpt-4o-mini, gpt-4o, ...)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_EXCERPT_CHARS=600      # tamanho do trecho da resposta do LLM guardado p/ rastreabilidade
