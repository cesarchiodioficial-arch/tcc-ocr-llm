# Copie para .env e ajuste. NUNCA versionar o .env.

# App
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10

# MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=tcc_ocr_llm
MONGO_COLLECTION=documents

# Armazenamento dos arquivos originais (volume)
UPLOAD_DIR=/data/uploads

# OCR
OCR_LANG=por
OCR_PREPROCESS=true
OCR_MIN_CHARS=20
OCR_TIMEOUT_SECONDS=60
PDF_DPI=300
# POPPLER_PATH=   # opcional, apenas para rodar fora do container (Windows)

# LLM — camada isolada. NUNCA commitar valores reais.
LLM_PROVIDER=openai          # openai | fake
LLM_API_KEY=changeme
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
