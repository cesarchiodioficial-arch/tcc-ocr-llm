{
  "openapi": "3.1.0",
  "info": {
    "title": "POC OCR + LLM — Notas Fiscais",
    "description": "POC do TCC — extração automática de dados em notas fiscais com OCR (Tesseract) e LLM. Fluxo: documento → OCR → LLM → validação sistêmica → validação humana → MongoDB. Campos: issuer_name, cnpj, issue_date, invoice_number, total_value.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Disponibilidade da API e do MongoDB",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "API e MongoDB disponíveis",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "MongoDB indisponível"
          }
        }
      }
    },
    "/api/v1/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Enviar documento e processar (síncrono)",
        "operationId": "create_document_api_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_create_document_api_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentOut"
                }
              }
            }
          },
          "400": {
            "description": "Requisição malformada (arquivo vazio, id inválido, corpo inválido)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Documento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Conflito de estado (validar documento em falha / reprocessar sem arquivo original)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "413": {
            "description": "Arquivo acima do limite configurado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "415": {
            "description": "Tipo de arquivo não suportado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Arquivo do tipo esperado mas ilegível / corpo inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "503": {
            "description": "Dependência indisponível (MongoDB) — nada foi gravado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
